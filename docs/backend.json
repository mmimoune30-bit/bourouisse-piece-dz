
{
  "entities": {
    "User": {
      "title": "ملف المستخدم",
      "description": "بيانات حساب المستخدم وصلاحياته في النظام",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { 
          "type": "string", 
          "enum": ["Super Admin", "Manager", "Financial Officer", "Customer Service", "Seller", "Customer"]
        },
        "status": { "type": "string", "enum": ["Active", "Blocked"] },
        "storeId": { "type": "string" },
        "subscription": {
          "type": "object",
          "properties": {
            "plan": { "type": "string" },
            "startDate": { "type": "string", "format": "date-time" },
            "endDate": { "type": "string", "format": "date-time" },
            "status": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FeaturedStore": {
      "title": "حملة إعلانية لمتجر",
      "description": "بيانات المتجر المميز أو الحصري في المساحات الإعلانية",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "storeName": { "type": "string" },
        "storeLocation": { "type": "string" },
        "storeLogo": { "type": "string" },
        "tier": { "type": "string", "enum": ["Exclusive", "Featured"] },
        "placement": { "type": "string", "enum": ["Home", "Search", "Both"] },
        "priority": { "type": "number" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Active", "Paused", "Expired"] }
      }
    },
    "FeaturedProduct": {
      "title": "منتج مميز",
      "description": "منتجات مختارة من طرف الإدارة للظهور في الواجهة الرئيسية",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "productPrice": { "type": "number" },
        "productImage": { "type": "string" },
        "sellerName": { "type": "string" },
        "priority": { "type": "number" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" }
      }
    },
    "SubscriptionRequest": {
      "title": "طلب اشتراك",
      "description": "طلب تفعيل أو تجديد باقة من قبل البائع",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "planId": { "type": "string" },
        "type": { "type": "string", "enum": ["New", "Renew", "Upgrade"] },
        "paymentMethod": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "refNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "سجلات المستخدمين" },
    "/featured_stores/{campaignId}": { "schema": "FeaturedStore", "description": "إدارة المتاجر المميزة والحصرية" },
    "/featured_products/{campaignId}": { "schema": "FeaturedProduct", "description": "إدارة المنتجات المميزة المروجة" },
    "/subscription_requests/{requestId}": { "schema": "SubscriptionRequest", "description": "طلبات الدفع والتنشيط" },
    "/notifications/{notificationId}": { "description": "إشعارات النظام" }
  }
}

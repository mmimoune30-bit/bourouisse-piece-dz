
{
  "entities": {
    "User": {
      "title": "ملف المستخدم",
      "description": "بيانات حساب المستخدم وصلاحياته في النظام",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { 
          "type": "string", 
          "enum": ["Super Admin", "Manager", "Financial Officer", "Customer Service", "Seller", "Customer"]
        },
        "status": { "type": "string", "enum": ["Active", "Blocked"] },
        "storeId": { "type": "string" },
        "subscription": {
          "type": "object",
          "properties": {
            "plan": { "type": "string" },
            "startDate": { "type": "string", "format": "date-time" },
            "endDate": { "type": "string", "format": "date-time" },
            "status": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CategoryMetadata": {
      "title": "بيانات التصنيف",
      "description": "الصور والروابط المخصصة لكل تصنيف قطع غيار",
      "type": "object",
      "properties": {
        "name_en": { "type": "string" },
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SiteSettings": {
      "title": "إعدادات الموقع",
      "description": "الإعدادات العامة والشعار الرئيسي",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "platformName": { "type": "string" },
        "maintenanceMode": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "سجلات المستخدمين" },
    "/category_images/{categoryId}": { "schema": "CategoryMetadata", "description": "صور وأيقونات التصنيفات" },
    "/site_settings/global": { "schema": "SiteSettings", "description": "إعدادات المنصة والشعار" },
    "/featured_stores/{campaignId}": { "description": "إدارة المتاجر المميزة والحصرية" },
    "/featured_products/{campaignId}": { "description": "إدارة المنتجات المميزة المروجة" },
    "/subscription_requests/{requestId}": { "description": "طلبات الدفع والتنشيط" },
    "/notifications/{notificationId}": { "description": "إشعارات النظام" }
  }
}
